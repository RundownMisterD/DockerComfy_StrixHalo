# =============================================================================
# ComfyUI Strix Halo Docker Configuration
# =============================================================================
# Adjust values as needed. All variables have sensible defaults in
# docker-compose.yml for the WSL2 (Windows) deployment.

# ---- Build-time settings ----------------------------------------------------
# BASE_IMAGE=rocm/pytorch:latest
# PYTORCH_ROCM_INDEX=https://download.pytorch.org/whl/rocm6.2
# COMFYUI_REF=master
# SKIP_PYTORCH_INSTALL=false

# ---- Network -----------------------------------------------------------------
COMFYUI_PORT=8188

# ---- Data directories (host paths) ------------------------------------------
# On Windows/WSL2 these are paths within the WSL2 filesystem.
# You can also use Windows paths via /mnt/c/... but WSL2-native paths are faster.
# Absolute paths recommended for production use.
COMFYUI_MODELS_DIR=./data/models
COMFYUI_OUTPUT_DIR=./data/output
COMFYUI_INPUT_DIR=./data/input
COMFYUI_CUSTOM_NODES_DIR=./data/custom_nodes
COMFYUI_USER_DIR=./data/user
COMFYUI_TEMP_DIR=./data/temp

# ---- WSL2-specific settings --------------------------------------------------
# Path to ROCm installation in your WSL2 distro (mounted into the container)
ROCM_PATH=/opt/rocm

# ---- Strix Halo GPU configuration -------------------------------------------
# Route gfx1151 through gfx1100 kernels (faster in most workloads today)
HSA_OVERRIDE_GFX_VERSION=11.0.0

# Disable SDMA to prevent checkerboard artifacts in VAE decode on APUs
HSA_ENABLE_SDMA=0

# Allow PyTorch to allocate all available unified memory
GPU_MAX_ALLOC_PERCENT=100
GPU_MAX_HEAP_SIZE=100

# Target the integrated GPU (device index 0)
HIP_VISIBLE_DEVICES=0

# PyTorch memory allocator tuning for unified memory (APU shares system RAM)
PYTORCH_HIP_ALLOC_CONF=backend:native,expandable_segments:True,garbage_collection_threshold:0.9,max_split_size_mb:512

# Use Triton flash attention backend (native flash-attn has no gfx1151 support)
FLASH_ATTENTION_TRITON_AMD_ENABLE=1
TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1

# ---- ComfyUI CLI arguments ---------------------------------------------------
# Default Strix Halo flags:
#   --bf16-vae     : use BF16 for VAE (recommended for RDNA 3.5)
#   --disable-mmap : avoid slow memory-mapping above 64GB (ROCm issue on Strix Halo)
#
# Other useful flags:
#   --highvram          : keep models in VRAM (useful with large unified memory)
#   --gpu-only          : run everything on GPU
#   --force-fp16        : force FP16 precision
#   --dont-print-server : suppress server output
COMFYUI_EXTRA_ARGS=--bf16-vae --disable-mmap
